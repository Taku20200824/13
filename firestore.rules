rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    function shortText(text) {
      return text is string && text.size() > 0 && text.size() <= 180;
    }

    // ── Хэрэглэгчийн профайл ба ranking ──────────────
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && me() == uid;
      allow delete: if false;
    }

    // ── Presence: хэн онлайн байгаа ──────────────────
    match /presence/{uid} {
      allow read: if signedIn();
      // Зөвхөн өөрийн дохиогоо бичнэ — өөр хүнийг "онлайн" болгож болохгүй
      allow delete: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid
                            && request.resource.data.uid == uid;
    }

    // ── Нийтийн chat ─────────────────────────────────
    match /publicChat/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.uid == me()
                    && shortText(request.resource.data.text);
      allow update, delete: if false;
    }

    // ── Өрөө ─────────────────────────────────────────
    match /rooms/{code} {

      function existing() { return resource.data; }
      function incoming() { return request.resource.data; }
      function isMember() { return me() in existing().members; }
      function isHost()   { return existing().host == me(); }

      // Host солигдож болох цорын ганц тохиолдол: одоогийн host
      // суудлаа орхисон, эсвэл удаан дохиогүй байх.
      function hostUnchanged() { return incoming().host == existing().host; }
      function hostSeatGone()  { return !(existing().host in existing().members); }
      function hostTimedOut() {
        return existing().hostSeenAt is number
               && request.time.toMillis() - existing().hostSeenAt > 30000;
      }

      allow read: if signedIn();

      allow create: if signedIn()
                    && incoming().host == me()
                    && incoming().status == 'waiting'
                    && me() in incoming().members;

      // Гишүүн болон шинээр нэгдэж буй хүн шинэчилж чадна, ГЭХДЭЭ:
      //   • host-ыг дур мэдэн өөрчилж болохгүй,
      //   • тоглоом эхлүүлэх (status өөрчлөх) эрх зөвхөн host-д.
      allow update: if signedIn()
                    && (isMember() || me() in incoming().members)
                    && (
                         hostUnchanged()
                         || isHost()
                         || ((hostSeatGone() || hostTimedOut()) && incoming().host == me())
                         || incoming().host == null
                       )
                    && (incoming().status == existing().status || isHost());

      allow delete: if signedIn() && isHost();

      // ── Өрөөний chat ───────────────────────────────
      match /messages/{messageId} {
        function room() {
          return get(/databases/$(database)/documents/rooms/$(code)).data;
        }
        allow read: if signedIn() && (
                      room().visibility == 'public' ||
                      me() in room().members
                    );
        allow create: if signedIn()
                      && me() in room().members
                      && request.resource.data.uid == me()
                      && shortText(request.resource.data.text);
        allow update, delete: if false;
      }

      // ── Гар: зөвхөн эзэн нь болон host уншина ──────
      match /hands/{seat} {
        function room() {
          return get(/databases/$(database)/documents/rooms/$(code)).data;
        }
        allow read: if signedIn() && (
                      resource.data.uid == me() ||
                      room().host == me()
                    );
        // Өөрийн гараа, эсвэл host нь bot-ын гарыг бичнэ
        allow write: if signedIn() && me() in room().members;
      }
    }
  }
}
