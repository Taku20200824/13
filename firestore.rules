rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }

    // Chat мессежийн бүрэн бүтэн байдал: зохиогч нь өөрөө, урт хязгаартай,
    // цаг нь бодит (ирээдүй рүү хуурамчаар түлхэж болохгүй).
    function validMessage() {
      return request.resource.data.uid == me()
             && request.resource.data.text is string
             && request.resource.data.text.size() > 0
             && request.resource.data.text.size() <= 180
             && request.resource.data.createdMs is number
             && request.resource.data.createdMs <= request.time.toMillis() + 5000
             && request.resource.data.createdMs >= request.time.toMillis() - 60000;
    }

    // ── Хэрэглэгчийн профайл ба ranking ──────────────
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && me() == uid;
      allow delete: if false;
    }

    // ── Presence ─────────────────────────────────────
    match /presence/{uid} {
      allow read: if signedIn();
      allow delete: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid
                            && request.resource.data.uid == uid;
    }

    // ── Нийтийн chat ─────────────────────────────────
    match /publicChat/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn() && validMessage();
      allow update, delete: if false;
    }

    // ── Өрөө ─────────────────────────────────────────
    match /rooms/{code} {

      function existing() { return resource.data; }
      function incoming()  { return request.resource.data; }
      function isMember()  { return me() in existing().members; }
      function isHost()    { return existing().host == me(); }

      function hostUnchanged() { return incoming().host == existing().host; }
      function hostSeatGone()  { return !(existing().host in existing().members); }
      function hostTimedOut() {
        return existing().hostSeenAt is number
               && request.time.toMillis() - existing().hostSeenAt > 30000;
      }

      // Зөвхөн host өөрчилж болох талбарууд. Гишүүн эдгээрийг хөндвөл
      // татгалзана — өмнө нь дурын гишүүн тоглоомыг эхлүүлэх, bot
      // тохиргоог солих боломжтой байсан.
      function hostOnlyFieldsUntouched() {
        return !request.resource.data.diff(resource.data)
                  .affectedKeys()
                  .hasAny(['status', 'allowBots', 'botLevel', 'visibility', 'gameId', 'startedAt']);
      }

      // state/stateVersion нь нүүдлээр өөрчлөгддөг — хамт л шинэчлэгдэнэ,
      // бөгөөд хувилбарын дугаар зөвхөн УРАГШ явна (дахин тоглуулахаас хамгаална).
      function versionMovesForward() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['state'])
               || (incoming().stateVersion is number
                   && incoming().stateVersion > (existing().stateVersion is number ? existing().stateVersion : 0));
      }

      allow read: if signedIn();

      allow create: if signedIn()
                    && incoming().host == me()
                    && incoming().status == 'waiting'
                    && me() in incoming().members;

      // Шинээр нэгдэж буй хүн зөвхөн суудал эзлэх эрхтэй: хүлээж буй
      // өрөө байх ёстой, тоглоомын төлөв/host/статусыг хөндөж болохгүй.
      // Өмнө нь өөрийгөө `members`-т нэмээд л дурын өрөөний төлөвийг
      // хуурамчаар бичих боломжтой байсан.
      function joiningCleanly() {
        return me() in incoming().members
               && existing().status == 'waiting'
               && !request.resource.data.diff(resource.data).affectedKeys()
                     .hasAny(['state', 'stateVersion', 'host', 'status', 'gameId', 'startedAt']);
      }

      allow update: if signedIn()
                    && (isMember() || joiningCleanly())
                    && (
                         hostUnchanged()
                         || isHost()
                         || ((hostSeatGone() || hostTimedOut()) && incoming().host == me())
                         || incoming().host == null
                       )
                    && (isHost() || hostOnlyFieldsUntouched())
                    && versionMovesForward();

      allow delete: if signedIn() && isHost();

      // ── Өрөөний chat ───────────────────────────────
      match /messages/{messageId} {
        function room() {
          return get(/databases/$(database)/documents/rooms/$(code)).data;
        }
        allow read: if signedIn() && (
                      room().visibility == 'public' ||
                      me() in room().members
                    );
        allow create: if signedIn() && me() in room().members && validMessage();
        allow update, delete: if false;
      }

      // ── Гар: зөвхөн эзэн нь болон host уншина ──────
      match /hands/{seat} {
        function room() {
          return get(/databases/$(database)/documents/rooms/$(code)).data;
        }
        // Баримт хараахан үүсээгүй байхад `resource` нь null болж,
        // `resource.data` алдаа өгдөг → сонсогч үхэж, тоглогч мөнхөд
        // хүлээдэг байсан. Хоосон баримтыг уншихад асуудалгүй.
        allow read: if signedIn() && (
                      resource == null ||
                      resource.data.uid == me() ||
                      room().host == me()
                    );
        // Өөрийн гараа бичнэ. Host нь bot-ын (uid: bot-*) гарыг бичнэ.
        // Өмнө нь дурын гишүүн бусдын гарыг дарж бичих боломжтой байсан.
        allow write: if signedIn()
                     && me() in room().members
                     && (
                          request.resource.data.uid == me()
                          || (room().host == me() && request.resource.data.uid != null)
                        );
      }
    }
  }
}
