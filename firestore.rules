rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function shortText(value) {
      return value is string && value.size() > 0 && value.size() <= 180;
    }

    // ── Хэрэглэгчийн профайл ба ranking ──────────────
    match /users/{uid} {
      // Ranking бүгдэд харагдана
      allow read: if signedIn();
      // Зөвхөн өөрийн бичлэгээ өөрчилнө
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // ── Нийтийн chat ─────────────────────────────────
    match /publicChat/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && shortText(request.resource.data.text);
      allow update, delete: if false;
    }

    // ── Өрөө ─────────────────────────────────────────
    match /rooms/{code} {
      allow read: if signedIn();

      // Үүсгэгч нь заавал өөрөө host байна
      allow create: if signedIn()
                    && request.resource.data.host == request.auth.uid
                    && request.resource.data.status == 'waiting'
                    && request.resource.data.visibility in ['public', 'private'];

      // Өрөөнд байгаа хүн (эсвэл нэгдэж буй хүн) шинэчилж чадна
      allow update: if signedIn() && (
                      request.auth.uid in resource.data.members ||
                      request.auth.uid in request.resource.data.members
                    );

      allow delete: if signedIn() && request.auth.uid == resource.data.host;

      // ── Өрөөний chat ───────────────────────────────
      match /messages/{messageId} {
        function room() {
          return get(/databases/$(database)/documents/rooms/$(code)).data;
        }
        allow read: if signedIn() && (
                      room().visibility == 'public' ||
                      request.auth.uid in room().members
                    );
        allow create: if signedIn()
                      && request.auth.uid in room().members
                      && request.resource.data.uid == request.auth.uid
                      && shortText(request.resource.data.text);
        allow update, delete: if false;
      }

      // ── Гар: зөвхөн эзэн нь болон host уншина ──────
      match /hands/{seat} {
        function room() {
          return get(/databases/$(database)/documents/rooms/$(code)).data;
        }
        allow read: if signedIn() && (
                      resource.data.uid == request.auth.uid ||
                      room().host == request.auth.uid
                    );
        // Хуваарилалт болон нүүдлийг өрөөний гишүүд бичнэ
        allow write: if signedIn() && request.auth.uid in room().members;
      }
    }
  }
}
